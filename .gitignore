# Python and tooling caches
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Runtime / debug artifacts
src/debug_logs/
# Deliberation traces (core/trace.py writes these here). Must match
# trace.default_trace_dir() or the "gitignored sidecar" is not ignored.
debug_logs/
*.log
debug.log
results/_spill/

# Per-cell preflight manifests written by `elicit run` (resolved_config.json
# and its per-cell variants). They are provenance for a run, not results: the
# config travels with the cell bundle in `kaggle_bundles/` and the authoritative
# copy is re-emitted next to the result file on completion.
results/resolved_*.json
results/resolved_config.json

# Generated analysis outputs (plots, metrics CSVs, test runs)
analysis_outputs/

# Simulation results. Each cell is ~5 MB, a grid is ~800 MB, and the files are
# reproducible from a config plus a seed vector. Kept out of the repository so the
# grid cannot bloat it; the analysis pipeline reads them from results/ locally.
results/
!results/.gitkeep

# Legacy plot output folder (interactive plot_results.py used to write here)
figures/

# Asset and LaTeX artifacts
assets/
assets/literature/
*supplementary_tables.tex

# Ad-hoc summary CSVs
*_summary.csv
*_dynamics.csv

# Local planning documents (strategy, application prep, experiment grids)
docs/planning/

# Manuscript is local-only. Reports and writing instructions remain tracked.
docs/paper/main.tex
docs/paper/main.pdf
docs/paper/macros.tex
docs/paper/sections/
docs/paper/figures/
docs/paper/tables/
docs/paper/bib/
docs/paper/scripts/
docs/paper/README.md

.VSCodeCounter/
.vscode/
